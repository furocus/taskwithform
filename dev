#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  printf 'Usage: %s {install|npm|node|up|mock|logs|down|status} [args...]\n' \
    "${0##*/}" >&2
}

compose() {
  docker compose --project-directory "$SCRIPT_DIR" "$@"
}

if (($# == 0)); then
  usage
  exit 2
fi

readonly command_name="$1"
shift

case "$command_name" in
  install)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose run --rm install
    ;;
  npm|node)
    if (($# == 0)); then
      usage
      exit 2
    fi
    compose run --rm install "$command_name" "$@"
    ;;
  up)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose up -d frontend backend
    ;;
  mock)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose --profile mock up -d mock
    ;;
  logs)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose logs -f frontend backend
    ;;
  down)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose down
    ;;
  status)
    if (($# != 0)); then
      usage
      exit 2
    fi
    compose ps
    ;;
  *)
    usage
    exit 2
    ;;
esac
